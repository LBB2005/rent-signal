# ── Google OAuth via NextAuth (required to sign in) ────────────────────────
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3002/api/auth/callback/google
AUTH_SECRET=            # generate with: npx auth secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Anthropic (required) ───────────────────────────────────────────────────
# Powers the orchestrator, the five specialist agents, and synthesis.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Perplexity (required) ──────────────────────────────────────────────────
# The agents' `search_web` tool — live Reddit, Yelp, news and market data.
# https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=pplx-...

# ── Rentcast (optional) ────────────────────────────────────────────────────
# Live rental listings. Without it the app serves generated demo listings,
# so you can run the whole thing without paying for listing data.
# https://app.rentcast.io/app/api
RENTCAST_API_KEY=

# ── Google Maps (optional) ─────────────────────────────────────────────────
# Geocoding, the map panel, and Street View photos for each listing.
# Enable: Maps JavaScript API, Geocoding API, Street View Static API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
